# Flutter ephemeral directory (generated by Flutter)
flutter/ephemeral/

# Visual Studio user-specific files (should not be committed)
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio project files (generated by CMake)
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Visual Studio build-related directories
x64/
x86/

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# Visual Studio IDE folder
.vs/

# Build output directory (should be in parent .gitignore but added here for clarity)
Build/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
